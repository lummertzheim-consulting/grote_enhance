<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_docs_entry_inherit" inherit_id="portal.portal_docs_entry" name="Hide Certain Portal Cards">

            <xpath expr="//div" position="attributes">
                <attribute name="t-att-class">
                    'o_portal_index_card ' +
                    ('' if force_show or config_card else 'd-none ') +
                    ('col-12 order-0' if show_count else 'col-md-6 order-2') +
                    (
                        ' d-none'
                        if request.env.user.is_internal_portal_user
                        and (
                            url.startswith('/my/orders')
                            or url.startswith('/my/invoices')
                            or url.startswith('/my/security')
                            or url.startswith('/knowledge/home')
                        )
                        else ''
                    )
                </attribute>
            </xpath>
    </template>
    <template id="grote_enhance_protal_side_content" inherit_id="portal.side_content">
        <xpath expr="//a" position="replace">
            <t t-if="request.env.user.is_internal_portal_user">

            </t>
            <t t-else="">
                <a role="button" href="/my/account" class="btn btn-link p-0 mt-3"><i class="fa fa-pencil"/> Edit information</a>
            </t>
        </xpath>
    </template>
    <template id="grote_enhance_portal_my_task" inherit_id="project.portal_my_task" name="Portal: My Task with Hide Sidebar">
        <xpath expr="//t[@t-set='classes']" position="replace">
            <t t-set="classes" t-value="'col-lg-4 col-xxl-3 d-print-none d-none'"/>
        </xpath>
        <xpath expr="//div[@id='task_content']" position="attributes">
            <attribute name="class">o_portal_content col-12 col-lg-12 col-xxl-12</attribute>
        </xpath>

    </template>


    <template id="portal_my_home_project" name="Projects / Tasks" inherit_id="project.portal_my_home" priority="40">
        <xpath expr="//div[@id='portal_service_category']/t[1]" position="attributes">
            <attribute name="t-if">not request.env.user.is_internal_portal_user</attribute>
        </xpath>
    </template>

    <record id="documents.portal_my_home_documents" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>

    <template id="portal_my_timesheets_inherit" inherit_id="hr_timesheet.portal_my_timesheets">
        <xpath expr="//t[@t-foreach='grouped_timesheets']/tbody/tr[hasclass('table-light')]/th[hasclass('text-end')]" position="attributes">
            <attribute name="colspan">5</attribute>
        </xpath>
        <xpath expr="//t[@t-foreach='grouped_timesheets']/tbody/tr[hasclass('table-light')]/th[hasclass('text-end')]" position="before">
            <t t-elif="groupby == 'week_name'">
                <t t-set="week_name" t-value="timesheets[0].week_name"/>
                <th colspan="6">
                    <t t-if="week_name">
                        <span t-esc="week_name"/>
                    </t>
                    <t t-else="">
                        No Woche
                    </t>
                </th>
            </t>
            <t t-elif="groupby == 'month_name'">
                <t t-set="month_name" t-value="timesheets[0].month_name"/>
                <th colspan="6">
                    <t t-if="month_name">
                        <span t-esc="month_name"/>
                    </t>
                    <t t-else="">
                        No Monat
                    </t>
                </th>
            </t>
            <t t-elif="groupby == 'year'">
                <t t-set="year" t-value="timesheets[0].year"/>
                <th colspan="6">
                    <t t-if="year">
                        <span t-esc="year"/>
                    </t>
                    <t t-else="">
                        No Jahr
                    </t>
                </th>
            </t>
            <th colspan="1" class="text-end text-muted" t-if="groupby in ('week_name')">
                <t t-set="employee_ids" t-value="timesheets.mapped('employee_id')"/>
                <t t-set="total_holiday_hours" t-value="0"/>
                <t t-set="total_week_hours" t-value="0"/>
                <t t-foreach="employee_ids" t-as="employee_id">
                    <t t-set="holiday_hours" t-value="employee_id._get_soll_project_hours(timesheets[0].week_name, timesheets[0].year)"/>
                    <t t-set="total_holiday_hours" t-value="total_holiday_hours + holiday_hours"/>

                    <t t-set="week_day_count" t-value="len(set(employee_id.resource_calendar_id.attendance_ids.mapped('dayofweek')))"/>
                    <t t-set="total_week_hours" t-value="total_week_hours + (week_day_count * employee_id.resource_calendar_id.hours_per_day)"/>
                </t>
                <!-- <span t-esc="total_week_hours" />
                <span t-esc="total_holiday_hours" /> -->
                <t t-set="final_week_hours" t-value="total_week_hours - total_holiday_hours"/>
                Soll Projekt-Stunden : <span t-esc="final_week_hours" t-options='{"widget": "float_time"}'/>
            </th>
        </xpath>
        <th name="t_label" position="before">
            <th t-if="not groupby == 'week_name'">Woche</th>
            <th t-if="not groupby == 'month_name'">Monat</th>
            <th t-if="not groupby == 'year'">Jahr</th>
        </th>
        <xpath expr="//tbody//td[hasclass('text-end')]" position="before">
            <td t-if="not groupby == 'week_name'"><span t-field="timesheet.week_name" t-att-title="timesheet.week_name"></span></td>
            <td t-if="not groupby == 'month_name'"><span t-field="timesheet.month_name" t-att-title="timesheet.month_name"></span></td>
            <td t-if="not groupby == 'year'"><span t-esc="str(timesheet.year)" t-att-title="str(timesheet.year)"></span></td>
        </xpath>
    </template>


    <template id="hr_timesheet.portal_my_home_timesheet" name="Timesheets" customize_show="True" inherit_id="portal.portal_my_home" priority="45">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="before">
            <t t-set="portal_service_category_enable" t-value="True"/>
        </xpath>
        <div id="portal_service_category" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="icon" t-value="'/hr_timesheet/static/img/timesheet.svg'"/>
                <t t-set="title">Zeiterfassung</t>
                <t t-set="url" t-value="'/my/timesheets?groupby=week_name'"/>
                <t t-set="text">Alle mit Ihren Projekte verbundene Zeiterfassungen prüfen</t>
                <t t-set="placeholder_count" t-value="'timesheet_count'"/>
            </t>
        </div>
    </template>

</odoo>
